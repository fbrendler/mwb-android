<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cartão de configuração (como os "SettingsCard" do PowerToys) -->
    <style name="PtCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/pt_card</item>
        <item name="strokeColor">@color/pt_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Linha interna do cartão: ícone | textos | controle -->
    <style name="PtCardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="PtCardIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="tint">@color/pt_text_primary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Textos -->
    <style name="PtText.PageTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pt_text_primary</item>
    </style>

    <style name="PtText.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pt_text_primary</item>
    </style>

    <style name="PtText.CardTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pt_text_primary</item>
    </style>

    <style name="PtText.CardDesc" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/pt_text_secondary</item>
    </style>

    <!-- Botões (cantos de 4dp como no Windows 11) -->
    <style name="PtButton.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/pt_accent</item>
        <item name="android:textColor">@color/pt_on_accent</item>
        <item name="iconTint">@color/pt_on_accent</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="PtButton.Standard" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/pt_control</item>
        <item name="strokeColor">@color/pt_control_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/pt_text_primary</item>
        <item name="iconTint">@color/pt_text_primary</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- Campo de texto -->
    <style name="PtTextField" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/pt_control</item>
        <item name="boxStrokeColor">@color/pt_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="hintTextColor">@color/pt_accent</item>
        <item name="android:textColorHint">@color/pt_text_secondary</item>
        <item name="endIconTint">@color/pt_text_secondary</item>
    </style>

    <style name="PtTextField.Edit" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pt_text_primary</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Cantos arredondados do ícone do app no cabeçalho -->
    <style name="PtShape.Icon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
</resources>
